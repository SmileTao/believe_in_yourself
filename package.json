{
  "name": "believe_in_yourself",
  "version": "0.1.0",
  "description": "士别三日 — 温暖治愈系自律工作台",
  "author": "SmileTao",
  "license": "MIT",
  "main": "out/main/index.js",
  "productName": "士别三日",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "seed": "tsx electron/db/seed.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win",
    "build:linux": "electron-vite build && electron-builder --linux",
    "postinstall": "node scripts/postinstall.js",
    "dequarantine": "codesign --force --deep --sign - node_modules/electron/dist/Electron.app && xattr -dr com.apple.quarantine node_modules/electron/dist/Electron.app"
  },
  "build": {
    "appId": "com.shibie.app",
    "productName": "士别三日",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "asarUnpack": [
        "**/*.{node,dylib}"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Productivity"
    },
    "dmg": {
      "title": "士别三日",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "echarts": "^5.5.1",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "less": "^4.2.0",
    "sharp": "^0.35.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
